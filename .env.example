# Copy to .env and fill in. Never commit .env itself.

# Neon pooled connection string (the *-pooler* host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — console.cloud.google.com → Credentials → OAuth client ID.
# Redirect URI must be exactly: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

